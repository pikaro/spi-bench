#!/bin/bash

if [ -t 1 ]; then
    COLOR=always
else
    COLOR=never
fi

FULL=0
if [ "$1" = "-f" ]; then
    FULL=1
    shift
fi

ENV="${1}"
shift

color() {
    if [ "$COLOR" = "never" ]; then
        shift
        printf "$*"
        return
    fi
    local num
    case $1 in
    black) num=30 ;;
    red) num=31 ;;
    green) num=32 ;;
    yellow) num=33 ;;
    blue) num=34 ;;
    magenta) num=35 ;;
    cyan) num=36 ;;
    white) num=37 ;;
    reset) num=0 ;;
    esac
    local code="\e[${num}m"
    shift
    printf "${code}$*\e[0m"
}

case "$ENV" in
master | gpu0 | gpu1 | media | ai)
    ADDR2LINE=~/.platformio/packages/toolchain-xtensa-esp-elf/bin/xtensa-esp32s3-elf-addr2line
    ;;
io)
    ADDR2LINE=~/.platformio/packages/toolchain-riscv32-esp/bin/riscv32-esp-elf-addr2line
    ;;
*)
    echo "Unknown environment"
    exit 1
    ;;
esac

LINE_COUNT="$(echo "$@" | wc -w)"
ELF="build/${ENV}/firmware.elf"
if [ ! -f "${ELF}" ]; then
    ELF=".pio/build/${ENV}/firmware.elf"
fi
if [ ! -f "${ELF}" ]; then
    echo "Firmware ELF not found for ${ENV}: checked build/${ENV}/firmware.elf and .pio/build/${ENV}/firmware.elf" >&2
    exit 1
fi

TRACE="$("${ADDR2LINE}" -fCe "${ELF}" "$@")"

if [ $FULL -ne 1 ]; then
    _DIR_REPR=(
        "[xten]" "${HOME}/.platformio/packages/toolchain-xtensa-esp-elf/xtensa-esp-elf"
        "[rtos]" "${HOME}/.platformio/packages/framework-espidf/components/freertos/FreeRTOS-Kernel"
        "[ldep]" "${HOME}/.platformio/libdeps/arduino_nano_esp32"
        "." "${PWD}"
    )
    _DIR_REPR_ARGS=()
    for ((i = 0; i < ${#_DIR_REPR[@]}; i += 2)); do
        _DIR_REPR_ARGS+=(-e "s!${_DIR_REPR[i + 1]}!${_DIR_REPR[i]}!")
    done
else
    _DIR_REPR_ARGS=(
        -e "s!${PWD}/!!"
    )
fi

_repr_loc() {
    local PATH_ LINE
    PATH_="$(echo "$1" | cut -d: -f1)"
    LINE="$(echo "$1" | cut -d: -f2)"
    echo "$(color cyan "$PATH_"):$(color yellow "$LINE")"
}

_repr_addr() {
    local ADDR="$1"
    echo "${ADDR}" |
        bat --color="${COLOR}" \
            --language='C++' \
            --plain \
            --paging=never
}

echo
for ((i = 1; i <= LINE_COUNT; i++)); do
    ADDR=$(echo "$TRACE" | sed -n "$((i * 2 - 1))p")
    LOCATION=$(echo "$TRACE" | sed -n "$((i * 2))p" | sed "${_DIR_REPR_ARGS[@]}" -e 's/(discriminator \([0-9]\+\))/#\1/')
    echo -e "[$(color white $i)] $(_repr_loc "$LOCATION")\n\n    $(_repr_addr "${ADDR}")\n"
done
