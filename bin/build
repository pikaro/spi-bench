#!/bin/bash

REPO_ROOT=$(git rev-parse --show-toplevel)
cd "$REPO_ROOT" || {
    echo "Failed to change directory to repository root"
    exit 1
}
. .venv/bin/activate

RET=0
pio run "$@" || RET=$?

find . -mindepth 1 -maxdepth 1 -type f -name '*.sarif' -and -not -name 'main.cpp.cpp.sarif' -delete
cat main.cpp.cpp.sarif | jq >/tmp/sarif.json
mv /tmp/sarif.json main.cpp.cpp.sarif

exit $RET
