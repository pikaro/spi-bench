#!/usr/bin/env bash

while read -r dirname; do
    export PATH="${dirname}:$PATH"
done < <(
    ls -d "${HOME}/.platformio/packages/toolchain-"*"/bin" \
        "${HOME}/.platformio/packages/toolchain-"*"/bin"
)

set -- "${HOME}/.local/bin/clangd" \
    --query-driver="${HOME}/.platformio/packages/toolchain-*/bin/*-gcc,${HOME}/.platformio/packages/toolchain-*/bin/*-g++" \
    --log=error \
    --background-index \
    --clang-tidy \
    --header-insertion=iwyu \
    --header-insertion-decorators \
    --pch-storage=memory \
    "$@"

if [ "${DEBUG:-}" = "1" ]; then
    env &>/tmp/clangd_env.log
    echo "$@" >>/tmp/clangd_call.log
fi

exec "$@"
