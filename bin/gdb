#!/bin/bash

if [ -z "$1" ]; then
    echo "Usage: $0 <env>"
    exit 1
fi

ENV="${1}"

shift

case "$ENV" in
master | gpu0 | gpu1 | media)
    GDB=~/.platformio/packages/tool-xtensa-esp-elf-gdb/bin/xtensa-esp-elf-gdb-no-python
    ;;
io)
    GDB=~/.platformio/packages/tool-riscv32-esp-elf-gdb/bin/riscv32-esp-elf-gdb-no-python
    ;;
*)
    echo "Unknown environment"
    exit 1
    ;;
esac

"${GDB}" ".pio/build/${ENV}/firmware.elf" "$@"
