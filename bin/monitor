#!/usr/bin/env bash

set -eEuo pipefail

if [ -z "${1:-}" ]; then
    echo "Usage: $0 <env> [baud]"
    echo "       $0 [monitor-multi options] <env>"
    exit 1
fi

SCRIPT_DIR="${BASH_SOURCE%/*}"

if [ "$#" -eq 2 ] && [[ "$1" != -* ]] && [[ "$2" =~ ^(h|l|[0-9]+)$ ]]; then
    exec "${SCRIPT_DIR}/monitor-multi" --baud "$2" "$1"
fi

exec "${SCRIPT_DIR}/monitor-multi" "$@"
