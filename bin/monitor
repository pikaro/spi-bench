#!/usr/bin/env bash

set -eEuo pipefail

# shellcheck source=/dev/null
. ~/.platformio/penv/bin/activate

eval "$("${BASH_SOURCE%/*}/select_port.py")"
pio device monitor -b 921600 --raw --port "$UPLOAD_PORT"

