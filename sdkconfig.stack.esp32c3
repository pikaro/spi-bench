# ESP32C3 max CPU frequency is 160MHz (not 240MHz like S3)
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=n
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_160=y

# ESP32C3 has no PSRAM
CONFIG_SPIRAM=n

CONFIG_ESPTOOLPY_FLASHSIZE="4MB"

# ESP32C3 has USB Serial/JTAG
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_USB_CDC=n
