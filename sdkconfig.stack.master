# The master low-speed SPI bus uses GPIO36/GPIO37. On ESP32-S3 OPI PSRAM
# builds those pins are part of the external memory bus, so PSRAM must stay
# disabled for this board wiring.
CONFIG_SPIRAM=n

# Master owns WiFi/network participation. The shared ESP32 stack disables these
# to keep the other nodes small, so enable them only in the master overlay.
CONFIG_ESP_NETIF_TCPIP_LWIP=y
CONFIG_LWIP_ENABLE=y
CONFIG_ESP_WIFI_ENABLED=y
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=y
CONFIG_ESP_WIFI_ENTERPRISE_SUPPORT=n
