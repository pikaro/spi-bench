## FFT table sizing
CONFIG_DSP_MAX_FFT_SIZE_512=n
CONFIG_DSP_MAX_FFT_SIZE_1024=y
CONFIG_DSP_MAX_FFT_SIZE_2048=n
CONFIG_DSP_MAX_FFT_SIZE_4096=n
CONFIG_DSP_MAX_FFT_SIZE_8192=n
CONFIG_DSP_MAX_FFT_SIZE_16384=n
CONFIG_DSP_MAX_FFT_SIZE_32768=n
CONFIG_DSP_MAX_FFT_SIZE=1024

# GPIO43/GPIO44 carry the active-low peak LED and an otherwise available v2
# signal. Keep UART0 off those pins and use native USB Serial/JTAG.
CONFIG_ESP_CONSOLE_UART_DEFAULT=n
CONFIG_ESP_CONSOLE_UART_CUSTOM=n
CONFIG_ESP_CONSOLE_USB_CDC=n
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_NONE=n
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG=n
